{
  "manifest_version": 3,
  "name": "Kırmızı Companion",
  "version": "1.0.4",
  "description": "Adds smooth cursor motion, click effects, and automatic zoom to Kırmızı screen recordings. Nothing leaves your device.",
  "homepage_url": "https://kirmizi.app",
  "permissions": ["system.display"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kirmizi.app/*",
        "https://www.kirmizi.app/*",
        "http://localhost/*",
        "https://localhost/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["collector.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
